# Mindtrip Clone — Environment Configuration
# Copy to .env and fill in values. The app runs fully offline with demo mode.

# --- Application ---
APP_NAME=Mindtrip Clone
ENVIRONMENT=development
API_PREFIX=/api

# --- Database ---
DATABASE_URL=sqlite:///./data/mindtrip.db

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM Provider (one of: demo | grok | groq | openai | openrouter | ollama | gemini) ---
LLM_PROVIDER=groq
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60

# Provider keys (only needed for live providers)
GROQ_API_KEY=your_groq_api_key_here
# Optional: additional Groq keys for auto-failover when one hits 429 rate limit
# (comma-separated; tried in order: primary, then backups)
GROQ_API_KEYS=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Routing ---
ENABLE_LIVE_ROUTING=true

# --- Scraper ingestion ---
USER_SCRAPER_DIR=./scrapers/user_scrapers
FIXTURES_PATH=./data/fixtures/sample_trips.json
AUTO_SEED=true

# --- Imagery (optional; Unsplash static fallbacks used when absent) ---
UNSPLASH_ACCESS_KEY= 
