# Copy this to .env for local development. Never commit the real .env.
API_KEY=change-me-in-development
HOST=127.0.0.1
PORT=8000
FILE_RETENTION_HOURS=24
CACHE_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=30
MAX_JOBS=10
MAX_JOBS_PER_HOUR=10
# OUTPUT_DIR defaults to ./output locally. Hosts with read-only filesystems use /tmp.
OUTPUT_DIR=output
# USE_PLAYWRIGHT_SOURCE=0 uses synthetic demo data. Set to 1 only with permission to automate Google Maps.
USE_PLAYWRIGHT_SOURCE=0
# Parallelism safety: JOB_WORKERS x PLAYWRIGHT_CONCURRENCY <= 14 (enforced in code).
JOB_WORKERS=3
PLAYWRIGHT_CONCURRENCY=4

# ---- Locality discovery (mapsofindia.com) ----
# Primary source for a city's localities: https://www.mapsofindia.com/<city>/localities/
# Set to 0 to skip it and go straight to OpenStreetMap.
USE_MAPSOFINDIA_LOCALITIES=1
# Client timeout (seconds) for each mapsofindia page fetch.
LOCALITIES_TIMEOUT=20
# Alphabetical sub-index pages followed on index-style city pages (Kolkata).
MAX_LOCALITY_INDEX_PAGES=8

# ---- Area discovery (city-wide sweep) ----
# Client timeout (seconds) for Overpass/Nominatim. Keep it above the Overpass
# server-side query timeout, otherwise every mirror times out.
AREAS_TIMEOUT=40
# Coordinate grid (N x N) used when OpenStreetMap cannot name the city's areas.
AREA_GRID_CELLS=3
# Areas scraped in parallel when the job is uncapped ("give me everything").
LOCATION_CONCURRENCY=2
# Stop a budgeted run after this many consecutive areas add no new listings.
MAX_STALE_AREAS=5

# ---- Runtime guardrails ----
# Optional hard stop in minutes (720 = 12 hours); 0 disables it (Apify's own timeout applies).
# Listings are streamed to the dataset, so partial data is never lost.
MAX_RUNTIME_MINUTES=720
# Consecutive non-growing scrolls before a results feed is treated as finished.
PLAYWRIGHT_SCROLL_STABLE=4
